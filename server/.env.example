# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/jobseeker_ai?retryWrites=true&w=majority
# If SRV DNS fails locally, use the standard Atlas URI:
# MONGODB_URI=mongodb://<username>:<password>@<host-0>:27017,<host-1>:27017,<host-2>:27017/jobseeker_ai?ssl=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# AI APIs
# Groq API (Free and Fast)
GROQ_API_KEY=your-groq-api-key
# Get from: https://console.groq.com/keys

# Google Gemini API (Alternative)
GEMINI_API_KEY=your-gemini-api-key
# Get from: https://ai.google.dev/

# Choose which AI to use: groq or gemini
AI_PROVIDER=groq
